# Normalise all text files to LF on commit (project targets Linux/macOS)
* text=auto eol=lf

# Binaries — no line ending conversion
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

# Explicitly text
*.py text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.txt text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.in text eol=lf
